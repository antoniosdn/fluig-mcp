# Copy to .env (or set these in your MCP client config) and fill in.
# .env is git-ignored; never commit real credentials.

# --- Required ---------------------------------------------------------------

# Base URL of the Fluig portal, including scheme and port.
FLUIG_HOST=https://fluig.example.com:8080

# A Fluig user. Most tools need administrative rights; process instance tools act
# as this user and need the corresponding roles.
FLUIG_USER=
FLUIG_PASS=

# --- Optional ---------------------------------------------------------------

# Tenant id. Use -1 to have the server resolve it from the user.
FLUIG_COMPANY=1

# Colleague id, when it differs from the login.
FLUIG_USERCODE=

# Expose only the tools that cannot change server state. Recommended when pointing
# an autonomous agent at anything you care about.
FLUIG_READONLY=0

# Fallback IPs, comma separated, probed when DNS is unreliable. Every candidate is
# TCP-tested before use, so a stale entry is harmless.
FLUIG_IPS=

# JNDI datasource names used by the SQL passthrough tools.
FLUIG_DATASOURCE=/jdbc/AppDS
FLUIG_RM_DATASOURCE=/jdbc/Corpore

# Dataset that relays TOTVS RM stored SQL statements. Varies per installation.
FLUIG_RM_BRIDGE_DATASET=ds_generic_rm_sql

# Prefix for the throwaway datasets this server creates to run SQL. Anything with
# this prefix on your server was created by fluig-mcp and is safe to delete.
FLUIG_SCRATCH_PREFIX=ds_mcp_

# Where the CLI writes downloaded artefacts (default: ./out).
FLUIG_OUT_DIR=
